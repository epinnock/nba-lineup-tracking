[run]
source = 
    api
    models
    processors
    exporters
    utils
    main.py

omit = 
    */tests/*
    */__init__.py
    */site-packages/*
    .venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\\bProtocol\\):
    @(abc\\.)?abstractmethod

ignore_errors = True

precision = 2

[html]
directory = htmlcov